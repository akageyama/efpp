program test_blocks
  implicit none
  logical :: just_once = .true.
  integer :: counter = 0
  integer :: i
  integer :: n_initialize = 0
  integer :: n_output = 0

  do i = 1, 20
    do <just_once>
      n_initialize = n_initialize + 1
    end do

    if <skip counter:8>
      n_output = n_output + 1
    end if
  end do

  if (n_initialize /= 1) stop 1
  if (n_output /= 3) stop 2
  if (counter /= 20) stop 3

  print *, "PASS: just_once and skip"
end program test_blocks
